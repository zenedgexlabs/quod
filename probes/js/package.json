{
  "name": "quod-js",
  "version": "0.2.3",
  "description": "Quod probe for JavaScript and TypeScript test runners (Vitest, Jest): per-test executed functions via V8 precise coverage",
  "type": "module",
  "license": "Apache-2.0",
  "author": "zenedgex labs",
  "homepage": "https://github.com/zenedgexlabs/quod#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenedgexlabs/quod.git",
    "directory": "probes/js"
  },
  "bugs": {
    "url": "https://github.com/zenedgexlabs/quod/issues"
  },
  "keywords": [
    "vitest",
    "jest",
    "test-selection",
    "test-impact-analysis",
    "ci",
    "quod"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "quod-js": "src/cli.mjs",
    "quod-vitest": "src/cli.mjs"
  },
  "exports": {
    "./reporter": "./src/reporter.mjs",
    "./setup": "./src/setup.mjs",
    "./coverage": "./src/coverage.mjs",
    "./jest-reporter": "./src/jest-reporter.mjs",
    "./jest-env": "./src/jest-env.cjs",
    "./jest-setup": "./src/jest-setup.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/probe.test.mjs"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
